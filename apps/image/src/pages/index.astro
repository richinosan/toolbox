<script>
  import * as editor from "../lib/editor";

  // ページ遷移（ClientRouter）でもスクリプトは再実行されないので、表示のたびに初期化する
  const init = () => {
    const root = document.querySelector<HTMLElement>("#image-editor");
    // このツール以外のページでは何もしない
    if (!root) return;
    editor.mount(root);
  };
  document.addEventListener("astro:page-load", init);
</script>

