---
import * as shared from "#shared";
import Layout from "#ui/Layout.astro";
import ToolIcon from "#ui/ToolIcon.astro";
import * as exporter from "../lib/exporter";
import * as model from "../lib/model";
import * as project from "../lib/project";

const tool = shared.tools.find((t) => t.id === "image")!;

// ツールバーのアイコン（線のアイコン。色は currentColor）
const icons = {
  new: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M12 11v6M9 14h6"/>',
  open: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v1"/><path d="M3 7v11a2 2 0 0 0 2 2h13l3-9H7l-3 9"/>',
  save: '<path d="M5 3h11l5 5v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M7 3v5h8V3M7 21v-7h10v7"/>',
  export:
    '<path d="M12 15V3M7 8l5-5 5 5"/><path d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"/>',
  image:
    '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m4 18 5-5 3 3 3-3 5 5"/>',
  text: '<path d="M5 7V4h14v3M12 4v16M9 20h6"/>',
  rect: '<rect x="4" y="6" width="16" height="12" rx="1.5"/>',
  ellipse: '<circle cx="12" cy="12" r="8"/>',
  frame:
    '<rect x="3" y="4" width="18" height="16" rx="2.5"/><rect x="6.5" y="8" width="4.5" height="8" rx="1"/><rect x="13" y="8" width="4.5" height="8" rx="1"/>',
  undo: '<path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/>',
  redo: '<path d="m15 14 5-5-5-5"/><path d="M20 9H9a5 5 0 0 0 0 10h3"/>',
  snap: '<path d="M6 3v6a6 6 0 0 0 12 0V3"/><path d="M6 7h4M14 7h4"/>',
  crop: '<path d="M6 2v14a2 2 0 0 0 2 2h14"/><path d="M18 22V8a2 2 0 0 0-2-2H2"/>',
} as const;
---

<Layout
  title={tool.name}
  description={tool.description}
  spec={{
    overview:
      "画像の読み込み、レイヤーの合成、フィルター（カラーフィルター・ガウスぼかし）、背面のフィルター（下に重なる絵をレイヤーの形でぼかす・色を変える）、空間変形（奥に倒す・曲げる・4 隅を動かす）、書き出し（PNG / JPEG / WebP / PSD）は、すべてブラウザ内（Canvas と JavaScript）で行います。空間変形は形を網目に分けて WebGL で貼り、WebGL が使えない環境では Canvas だけで描きます。元の文字・画像はそのまま持ち、描くときにだけ変形するので、変形したテキストも打ち直せます。テキストの既定のフォントは LINE Seed JP で、Web フォント（Fontsource）・端末のフォント・フォントファイルも使えます。保存するときは、フォントの無い端末でも同じ見た目で表示できるよう、文字の形（パス）も作品ファイルに入れます。",
    network:
      "開いた画像や入力した文字がサーバーへ送信されることはありません。Web フォントを選んだときだけ、そのフォントのファイル（使う文字の範囲の分だけ）を jsDelivr（cdn.jsdelivr.net）の Fontsource から読み込み、フォントの名前で探したときだけ、フォントの一覧を Fontsource（api.fontsource.org）から読み込みます。PSD の書き出しと文字のパス化に使うライブラリは、使うときに同じサイトから読み込みます。",
    storage:
      "オフラインでも開けるよう、ページ・スクリプト・フォントをブラウザのキャッシュ（Cache Storage）に保存します。編集中の作品と使っている画像は、誤って再読み込みしても消えないよう IndexedDB に一時保存し、再読み込みすると開き直します。一時保存はタブごとに分け（タブの識別子だけ sessionStorage に保存）、そのタブを閉じると読み出せなくなり、7 日間更新のないものは次に開いたときに削除します。localStorage・Cookie は使いません。保存（Ctrl+S）すると、作品ファイル（.tbimg）として端末に保存します（対応ブラウザでは選んだファイルに上書き、それ以外のブラウザではダウンロード）。",
    libraries: [
      "ag-psd（PSD の書き出し）",
      "fontkit（文字の形をパスにする）",
      "Fontsource（Web フォント）",
    ],
  }}
  tour={[
    {
      target: "#add-tools",
      title: "レイヤーを追加・トリミング",
      body: "画像・テキスト・四角・丸・フレームを、レイヤーとして重ねます。フレームは Web の div のような入れ物で、中に入れたレイヤーを横並び・縦並び（flex）やグリッドで並べられます。画像はキャンバスにドロップしたり、貼り付けたりしても追加できます。「トリミング」では、キャンバスを 1:1・4:5・16:9・OGP・X・A4 などの比率に切り抜けます。",
    },
    {
      target: "#stage",
      title: "キャンバス",
      body: "レイヤーはドラッグで動かし、ハンドルで大きさを変えます。キャンバスや他のレイヤーの端・中心にスナップします（ツールバーのスナップで切り替え。Alt キーを押している間は無効）。空間変形の「4 隅を動かす」では、四角いハンドルで角を自由に動かせます（Enter か Esc で終了）。2 本指またはCtrl+ホイールで拡大・縮小できます。",
    },
    {
      target: "#layers-panel",
      title: "レイヤー",
      body: "上にあるものほど手前に表示されます。フレームの中身は、フレームの下に字下げして並びます。目のボタンで表示・非表示を切り替え、下のボタンで重なり順の変更・複製・削除・フレームで囲む・フレームから出すができます。",
    },
    {
      target: "#props-panel",
      title: "設定",
      body: "選んだレイヤーの文字・フォント・色・大きさ（−/+・スライダー・Shift+矢印キー）、ボックス（余白・背景・枠線・角の丸さ。CSS の padding・border と同じ）、フレームの並べ方（自由・横並び・縦並び・グリッド）、空間変形（縦・横に奥へ倒す、円弧・アーチ・旗・波などに曲げる、4 隅を動かす）と、カラーフィルターやガウスぼかし、背面のフィルター（すりガラスなど）を変えます。テキストは文字を選ぶと、その文字だけの書式を変えられます。図形は「キャンバスに合わせる」で、キャンバス全体に広げたり、縦横比を保ったまま収めたりできます。何も選んでいないときは、キャンバスの大きさと背景を変えられます。",
    },
    {
      target: "#file-tools",
      title: "保存と書き出し",
      body: "保存（Ctrl+S）で作品ファイル（.tbimg）を端末に保存し、あとで開いて続きから編集できます。書き出しでは PNG・JPEG・WebP の画像や、レイヤー付きの PSD（空間変形したレイヤーは変形後の画素で）を保存し、PNG はクリップボードにコピーもできます。JPEG・WebP は「1 MB 以下」のようにファイルサイズの上限を指定して圧縮できます。",
    },
  ]}
>
  <div class="page">
    <div class="tool-header">
      <ToolIcon name={tool.icon} />
      <h1 class="tool-header__name">{tool.name}</h1>
    </div>

    <div id="image-editor" class="editor" data-state="empty">
      <div class="toolbar" role="toolbar" aria-label="IMAGE の操作">
        <div class="toolbar__group" id="file-tools">
          <button class="tool" type="button" data-action="new" title="新規作成">
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.new} />
            <span>新規</span>
          </button>
          <button
            class="tool"
            type="button"
            data-action="open"
            title="開く（Ctrl+O）"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.open} />
            <span>開く</span>
          </button>
          <button
            class="tool ready-only"
            type="button"
            data-action="save"
            title="保存（Ctrl+S）"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.save} />
            <span>保存</span>
          </button>
          <button
            class="tool ready-only"
            type="button"
            data-action="export"
            title="書き出し（Ctrl+E）"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              set:html={icons.export}
            />
            <span>書き出し</span>
          </button>
        </div>
        <div class="toolbar__group" id="add-tools">
          <button
            class="tool"
            type="button"
            data-action="add-image"
            title="画像を追加"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              set:html={icons.image}
            />
            <span>画像</span>
          </button>
          <button
            class="tool ready-only"
            type="button"
            data-action="add-text"
            title="テキストを追加"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.text} />
            <span>テキスト</span>
          </button>
          <button
            class="tool ready-only"
            type="button"
            data-action="add-rect"
            title="四角を追加"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.rect} />
            <span>四角</span>
          </button>
          <button
            class="tool ready-only"
            type="button"
            data-action="add-ellipse"
            title="丸を追加"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              set:html={icons.ellipse}
            />
            <span>丸</span>
          </button>
          <button
            class="tool ready-only"
            type="button"
            data-action="add-frame"
            title="フレームを追加（中に入れたレイヤーを並べる入れ物）"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              set:html={icons.frame}
            />
            <span>フレーム</span>
          </button>
          <button
            class="tool tool--toggle ready-only"
            type="button"
            data-action="crop"
            aria-pressed="false"
            title="トリミング（キャンバスを切り抜く）"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.crop} />
            <span>トリミング</span>
          </button>
        </div>
        <div class="toolbar__group">
          <button
            class="tool"
            type="button"
            data-action="undo"
            title="元に戻す（Ctrl+Z）"
            disabled
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.undo} />
            <span>戻す</span>
          </button>
          <button
            class="tool"
            type="button"
            data-action="redo"
            title="やり直す（Ctrl+Shift+Z）"
            disabled
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.redo} />
            <span>やり直す</span>
          </button>
          <button
            class="tool tool--toggle ready-only"
            type="button"
            data-action="snap"
            aria-pressed="true"
            title="スナップ（Alt キーを押している間は無効）"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.snap} />
            <span>スナップ</span>
          </button>
        </div>
      </div>

      <div class="workspace">
        <div class="stage-wrap">
          <div
            id="stage"
            class="stage"
            role="img"
            aria-label="キャンバス（ドラッグでレイヤーを移動、ハンドルで大きさを変更）"
          >
            <canvas id="view" class="stage__canvas"></canvas>
            <div
              id="stage-text"
              class="rich stage-text"
              contenteditable="true"
              role="textbox"
              aria-multiline="true"
              aria-label="テキストを編集"
              data-placeholder="文字を入力"
              spellcheck="false"
              hidden
            ></div>
            <div id="empty" class="empty">
              <p class="empty__title">画像をドロップするか、選んでください</p>
              <div class="empty__actions">
                <button
                  class="button button--primary"
                  type="button"
                  data-action="add-image"
                >
                  画像を開く
                </button>
                <button class="button" type="button" data-action="new">
                  白紙から作る
                </button>
                <button class="button" type="button" data-action="open">
                  作品ファイルを開く
                </button>
              </div>
            </div>
            <div class="zoom ready-only">
              <button
                class="zoom__button"
                type="button"
                data-action="zoom-out"
                aria-label="縮小"
              >
                −
              </button>
              <span id="zoom-label" class="zoom__label" aria-live="polite">
                100%
              </span>
              <button
                class="zoom__button"
                type="button"
                data-action="zoom-in"
                aria-label="拡大"
              >
                +
              </button>
              <button
                class="zoom__button zoom__button--fit"
                type="button"
                data-action="zoom-fit"
                aria-label="全体を表示"
              >
                全体
              </button>
            </div>
            <div id="crop-bar" class="crop-bar" hidden>
              <button
                class="button button--small"
                type="button"
                data-action="crop-cancel"
              >
                キャンセル
              </button>
              <button
                class="button button--small button--primary"
                type="button"
                data-action="crop-apply"
              >
                切り抜く
              </button>
            </div>
            <div id="text-bar" class="crop-bar text-bar" hidden>
              <span class="text-bar__label">
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  set:html={icons.text}
                />
                テキストを編集中
              </span>
              <button
                class="button button--small button--primary"
                type="button"
                data-action="text-done"
              >
                完了
              </button>
            </div>
            <p id="toast" class="toast" role="status"></p>
          </div>
        </div>

        <div class="panels">
          <section
            id="layers-panel"
            class="card panel"
            aria-labelledby="layers-title"
          >
            <h2 id="layers-title" class="panel__title">
              レイヤー
            </h2>
            <p id="layer-empty" class="note">
              画像を開くか、白紙から作るとレイヤーを追加できます。
            </p>
            <ul id="layer-list" class="layers"></ul>
            <div id="layer-actions" class="layer-actions" hidden>
              <button
                class="button button--small"
                type="button"
                data-action="layer-up"
              >
                上へ
              </button>
              <button
                class="button button--small"
                type="button"
                data-action="layer-down"
              >
                下へ
              </button>
              <button
                class="button button--small"
                type="button"
                data-action="layer-duplicate"
              >
                複製
              </button>
              <button
                class="button button--small button--danger"
                type="button"
                data-action="layer-delete"
              >
                削除
              </button>
              <button
                class="button button--small"
                type="button"
                data-action="layer-wrap"
                title="選んでいるレイヤーをフレームに入れて、余白や背景を付けられるようにします"
              >
                フレームで囲む
              </button>
              <button
                class="button button--small"
                type="button"
                data-action="layer-unwrap"
                hidden
              >
                フレームから出す
              </button>
            </div>
          </section>

          <section
            id="props-panel"
            class="card panel"
            aria-labelledby="props-title"
          >
            <h2 id="props-title" class="panel__title">
              設定
            </h2>

            <form id="doc-props" class="fields" autocomplete="off" hidden>
              <label class="field">
                <span class="field__label">作品名</span>
                <input
                  class="input"
                  type="text"
                  name="name"
                  maxlength="200"
                  autocomplete="off"
                />
              </label>
              <div class="pair">
                <label class="field">
                  <span class="field__label">幅（px）</span>
                  <input
                    class="input"
                    type="number"
                    name="width"
                    min="1"
                    max={model.MAX_SIDE}
                    step="1"
                    inputmode="numeric"
                  />
                </label>
                <label class="field">
                  <span class="field__label">高さ（px）</span>
                  <input
                    class="input"
                    type="number"
                    name="height"
                    min="1"
                    max={model.MAX_SIDE}
                    step="1"
                    inputmode="numeric"
                  />
                </label>
              </div>
              <div class="field">
                <span class="field__label">背景</span>
                <div class="inline">
                  <input
                    class="swatch"
                    type="color"
                    name="background"
                    aria-label="背景色"
                  />
                  <label class="check">
                    <input type="checkbox" name="transparent" />
                    <span>透明</span>
                  </label>
                </div>
              </div>
              <p class="note">
                レイヤーを選ぶと、そのレイヤーの設定に切り替わります。
              </p>
            </form>

            <form id="crop-props" class="fields" autocomplete="off" hidden>
              <fieldset class="chips">
                <legend class="field__label">比率</legend>
                <div class="chips__options">
                  {model.cropPresets.map((preset, i) => (
                    <label class="chip">
                      <input
                        class="chip__input"
                        type="radio"
                        name="crop-preset"
                        value={preset.id}
                        checked={i === 0}
                      />
                      <span class="chip__label">
                        {preset.label}
                        {(preset.size || preset.note) && (
                          <span class="chip__sub">
                            {preset.size
                              ? `${preset.size[0]} × ${preset.size[1]}`
                              : preset.note}
                          </span>
                        )}
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>
              <p id="crop-size" class="crop-size" aria-live="polite"></p>
              <label id="crop-fit" class="check" hidden>
                <input type="checkbox" name="crop-fit" checked />
                <span id="crop-fit-label"></span>
              </label>
              <p class="note">
                枠をドラッグして位置を、角をドラッグして大きさを変えます。Enter
                で切り抜き、Esc
                でやめます。切り抜いたあとも「戻す」で元に戻せます。
              </p>
              <div class="crop-actions">
                <button class="button" type="button" data-action="crop-cancel">
                  キャンセル
                </button>
                <button
                  class="button button--primary"
                  type="button"
                  data-action="crop-apply"
                >
                  切り抜く
                </button>
              </div>
            </form>

            <p class="note props-empty">
              画像を開くか、白紙から作ると設定できます。
            </p>

            <form id="props" class="fields" autocomplete="off" hidden>
              <label class="field">
                <span class="field__label">レイヤー名</span>
                <input
                  class="input"
                  type="text"
                  data-prop="name"
                  maxlength="200"
                  autocomplete="off"
                />
              </label>

              <div class="fields" data-for="text">
                <div class="field">
                  <label id="rich-label" class="field__label" for="rich">
                    テキスト
                  </label>
                  <div
                    id="rich"
                    class="input rich rich--plain"
                    contenteditable="true"
                    role="textbox"
                    aria-multiline="true"
                    aria-labelledby="rich-label"
                    aria-describedby="rich-hint"
                    data-placeholder="表示する文字を入力"
                    spellcheck="false"
                  ></div>
                  <p id="rich-hint" class="note">
                    一部を選ぶと、その文字だけ書式を変えられます。色の違う文字には、その色の下線が付きます。
                  </p>
                </div>
                <div class="subhead">
                  <span class="subhead__title">文字の書式</span>
                  <span id="char-scope" class="scope" aria-live="polite">
                    全体に適用
                  </span>
                </div>
                <div class="field">
                  <span class="field__label" id="font-label">
                    フォント
                  </span>
                  <button
                    id="font-button"
                    class="input font-button"
                    type="button"
                    data-action="pick-font"
                    aria-labelledby="font-label font-name"
                    aria-haspopup="dialog"
                  >
                    <span id="font-name" class="font-button__name">
                      LINE Seed JP
                    </span>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="m7 10 5 5 5-5"></path>
                    </svg>
                  </button>
                </div>
                <p id="font-missing" class="note note--warn" hidden></p>
                <div class="size">
                  <label class="field__label" for="char-size">
                    大きさ（px）
                  </label>
                  <div class="stepper">
                    <button
                      class="stepper__button"
                      type="button"
                      data-char-step="-1"
                      aria-label="小さくする"
                      aria-controls="char-size"
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 12h12"></path>
                      </svg>
                    </button>
                    <input
                      id="char-size"
                      class="input stepper__input"
                      type="number"
                      data-char="size"
                      min="1"
                      max="2000"
                      step="1"
                      inputmode="numeric"
                      enterkeyhint="done"
                      aria-describedby="char-size-hint"
                    />
                    <button
                      class="stepper__button"
                      type="button"
                      data-char-step="1"
                      aria-label="大きくする"
                      aria-controls="char-size"
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 12h12M12 6v12"></path>
                      </svg>
                    </button>
                  </div>
                  <input
                    class="range__input size__slider"
                    type="range"
                    data-char="size-slider"
                    min="0"
                    max="1000"
                    step="1"
                    aria-label="大きさ（スライダー）"
                    aria-describedby="char-size-hint"
                  />
                  <p id="char-size-hint" class="note size__hint">
                    −・＋は長押しで続けて変わります。欄では ↑↓ で 1、Shift+↑↓ で
