---
import * as shared from "#shared";
import Layout from "#ui/Layout.astro";
import ToolTile from "#ui/ToolTile.astro";
---

<Layout
  title="Toolbox"
  description="小さな Web ツールの一覧"
  spec={{
    overview:
      "ツール一覧をビルド時に生成した静的ページです。ブラウザでの処理はありません。",
    network: "なし（ページ自体とフォントの読み込みのみ）",
    storage: "なし",
    libraries: [],
  }}
>
  <h1 class="page-title">ツール一覧</h1>
  <ul class="tool-list">
    {shared.tools.map((tool) => (
      <li>
        <ToolTile tool={tool} />
      </li>
    ))}
  </ul>
</Layout>

<style>
  .page-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-6);
  }

  .tool-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 160px), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
