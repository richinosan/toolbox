---
import * as shared from "#shared";
import Layout from "#ui/Layout.astro";
import ToolIcon from "#ui/ToolIcon.astro";

const tool = shared.tools.find((t) => t.id === "calendar")!;
---

<Layout
  title={tool.name}
  description={tool.description}
  spec={{
    overview:
      "入力された日付の解釈と曜日・祝日・Unix time・起算日からの残り日数の計算、複数行の整形は、すべてブラウザ内（JavaScript）で行います。祝日は外部のデータを使わず「国民の祝日に関する法律」に沿って計算します（振替休日・国民の休日を含む。春分の日・秋分の日は近似式による計算のため、先の年は推計です。2151 年以降は計算できないので「不明」と表示します）。日付のみの入力は JST (UTC+09:00) の 00:00:00 として扱います。",
    network: "なし（入力した日付がサーバーへ送信されることはありません）",
    storage:
      "オフラインでも開けるよう、ページ・スクリプト・フォントをブラウザのキャッシュ（Cache Storage）に保存します。localStorage には、選んだ入力モード（「1件」か「複数行」）と、複数行で残り日数を付けるかどうかだけを保存します。入力した日付と起算日は保存しません。Cookie は使いません。",
    libraries: ["luxon（日付の解釈と計算）"],
  }}
  tour={[
    {
      target: "#mode-switch",
      title: "入力モード",
      body: "「1件」は 1 つの日付の曜日と Unix time を、「複数行」は何行もの日付をまとめて整形します。",
    },
    {
      target: "#date-text",
      reveal: "#mode-single",
      title: "日付を入力",
      body: "2026-10-01、2026年10月1日、10/1、20261001 などの形式で入力できます。年や月を省略すると今年・今月として扱います。",
    },
    {
      target: "#date-picker-button",
      reveal: "#mode-single",
      title: "カレンダーから選ぶ",
      body: "カレンダーで日付を選ぶこともできます。テキスト入力と連動します。",
    },
    {
      target: "#start-text",
      reveal: "#mode-single",
      title: "起算日",
      body: "上の日付を期限として、起算日から「あと何日」かを数えます。最初は今日が入っています。明日が期限なら「あと 1 日」、今日なら「本日中」です。",
    },
    {
      target: ".result",
      reveal: "#mode-single",
      title: "結果",
      body: "起算日から期限までの日数、入力した日付の曜日、祝日・休日の名前、Unix time（秒）が表示されます。",
    },
    {
      target: "#multi-input",
      reveal: "#mode-multi",
      title: "複数行で入力",
      body: "1 行に 1 つずつ日付を書きます。形式は行ごとに違っていても構いません。「2027年10月17日(日) 開催」のように文章が続く行や、予定表をそのまま貼り付けても、日付の部分だけを読み取ります。",
    },
    {
      target: "#multi-output",
      reveal: "#mode-multi",
      title: "まとめて出力",
      body: "日付の部分を「2026年10月01日(木)」の形式に整え、それ以外の文字はそのまま、入力と同じ行に出力します。祝日・休日は「(火・祝)」のように表示します。右上のボタンで全部コピーできます。",
    },
    {
      target: "#multi-days",
      reveal: "#mode-multi",
      title: "残り日数",
      body: "オンにすると、出力の日付の後ろに今日から数えた残り日数を「（あと 1 日）」「（本日中）」のように付けます。オン・オフは次に開いたときも覚えています。",
    },
  ]}
>
  <div class="page">
    <div class="tool-header">
      <ToolIcon name={tool.icon} />
      <h1 class="tool-header__name">{tool.name}</h1>
    </div>

    <section class="card calendar">
      <!-- 1 件ずつ調べるモードと、複数行をまとめて整形するモード -->
      <div id="mode-switch" class="mode" role="group" aria-label="入力モード">
        <button
          id="mode-single"
          class="mode__button"
          type="button"
          aria-pressed="true"
        >
          1件
        </button>
        <button
          id="mode-multi"
          class="mode__button"
          type="button"
          aria-pressed="false"
        >
          複数行
        </button>
      </div>

      <div id="single-panel" class="panel">
        <div class="field">
          <label class="field__label" for="date-text">
            日付
          </label>
          <div class="field__inputs">
            <input
              id="date-text"
              class="field__input field__input--text"
              type="text"
              inputmode="text"
              autocomplete="off"
              placeholder="2026-10-01, 10/1, 20261001 など"
              aria-describedby="date-note"
            />
            <!-- ネイティブの date input はブラウザの言語設定で表記が変わる（mm/dd/yyyy など）ため、
                 表示はサービスの言語設定に合わせたボタンにして、カレンダーは showPicker() で開く -->
            <div class="picker">
              <button
                id="date-picker-button"
                class="field__input picker__button"
                type="button"
                aria-label="カレンダーから選択"
              >
                <span id="date-picker-label" class="picker__label">
                  yyyy/mm/dd
                </span>
                <svg
                  class="picker__icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                  <path d="M3 10h18M8 3v4M16 3v4"></path>
                </svg>
              </button>
              <input
                id="date-picker"
                class="picker__native"
                type="date"
                tabindex="-1"
                aria-hidden="true"
              />
            </div>
          </div>
        </div>
        <p id="date-note" class="note" aria-live="polite"></p>

        <!-- 上の日付を期限日として、起算日（デフォルトは今日）から「あと何日」かを数える -->
        <div class="field">
          <label class="field__label" for="start-text">
            起算日
          </label>
          <div class="field__inputs">
            <input
              id="start-text"
              class="field__input field__input--text"
              type="text"
              inputmode="text"
              autocomplete="off"
              placeholder="空欄なら今日"
              aria-describedby="start-note"
            />
            <div class="picker">
              <button
                id="start-picker-button"
                class="field__input picker__button"
                type="button"
                aria-label="起算日をカレンダーから選択"
              >
                <span id="start-picker-label" class="picker__label">
                  yyyy/mm/dd
                </span>
                <svg
                  class="picker__icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                  <path d="M3 10h18M8 3v4M16 3v4"></path>
                </svg>
              </button>
              <input
                id="start-picker"
                class="picker__native"
                type="date"
                tabindex="-1"
                aria-hidden="true"
              />
            </div>
          </div>
        </div>
        <p id="start-note" class="note" aria-live="polite"></p>

        <dl class="result" aria-live="polite">
          <div class="result__row">
            <dt>残り日数</dt>
            <dd id="days-left">—</dd>
          </div>
          <div class="result__row">
            <dt>曜日</dt>
            <dd id="weekday">—</dd>
          </div>
          <div class="result__row">
            <dt>祝日・休日</dt>
            <dd id="holiday">—</dd>
          </div>
          <div class="result__row">
            <dt>Unix time（秒）</dt>
            <dd class="result__value">
              <span id="unix-time" class="result__mono">
                —
              </span>
              <span class="copy">
                <button
                  id="copy-unix-time"
                  class="copy__button"
                  type="button"
                  aria-label="Unix time をコピー"
                  aria-describedby="copy-tooltip"
                  disabled
                >
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="9" y="9" width="12" height="12" rx="2"></rect>
                    <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
                  </svg>
                </button>
                <!-- レイアウトに影響しないよう、コピー結果はボタン上のツールチップで出す -->
                <span
                  id="copy-tooltip"
                  class="copy__tooltip"
                  role="status"
                ></span>
              </span>
            </dd>
          </div>
        </dl>
      </div>

      <div id="multi-panel" class="panel" hidden>
        <div class="field">
          <label class="field__label" for="multi-input">
            日付（1 行ごとに読み取り）
          </label>
          <textarea
            id="multi-input"
            class="field__input multi__textarea"
            rows="6"
            spellcheck="false"
            autocomplete="off"
            placeholder={"2026-10-01\n10/2\n2026年10月3日(土) 締め切り"}
          ></textarea>
        </div>
        <!-- 出力の日付の後ろに、今日から数えた残り日数を付けるかどうか（選択は localStorage に覚える） -->
        <label class="switch">
          <input
            id="multi-days"
            class="switch__input"
            type="checkbox"
            role="switch"
          />
          <span>残り日数を付ける（今日から数えます）</span>
        </label>
        <div class="field">
          <div class="multi__head">
            <label class="field__label" for="multi-output">
              出力（yyyy年mm月dd日(曜)、祝日は(曜・祝)）
            </label>
            <span class="copy">
              <button
                id="copy-multi"
                class="copy__button"
                type="button"
                aria-label="出力をすべてコピー"
                aria-describedby="copy-multi-tooltip"
                disabled
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="9" y="9" width="12" height="12" rx="2"></rect>
                  <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
                </svg>
              </button>
              <span
                id="copy-multi-tooltip"
                class="copy__tooltip"
                role="status"
              ></span>
            </span>
          </div>
          <textarea
            id="multi-output"
            class="field__input multi__textarea"
            rows="6"
            readonly
            spellcheck="false"
          ></textarea>
        </div>
        <p id="multi-note" class="note" aria-live="polite"></p>
      </div>
    </section>
  </div>
</Layout>

<script>
  import * as luxon from "luxon";
  import * as motion from "#ui/motion.ts";
  import * as date from "../lib/date";
  import * as holiday from "../lib/holiday";

  // ページ遷移（ClientRouter）でもスクリプトは再実行されないので、表示のたびに初期化する
  const init = () => {
    const text = document.querySelector<HTMLInputElement>("#date-text");
    // ClientRouter で他のページから遷移したときも初期化する（カレンダー以外のページでは何もしない）
    if (!text) return;
    const picker = document.querySelector<HTMLInputElement>("#date-picker")!;
    const pickerButton = document.querySelector<HTMLButtonElement>(
      "#date-picker-button",
    )!;
    const pickerLabel =
      document.querySelector<HTMLElement>("#date-picker-label")!;
    const note = document.querySelector<HTMLElement>("#date-note")!;
    const weekday = document.querySelector<HTMLElement>("#weekday")!;
    const holidayValue = document.querySelector<HTMLElement>("#holiday")!;
    const unixTime = document.querySelector<HTMLElement>("#unix-time")!;
    const copyButton =
      document.querySelector<HTMLButtonElement>("#copy-unix-time")!;
    const copyTooltip = document.querySelector<HTMLElement>("#copy-tooltip")!;
    const startText = document.querySelector<HTMLInputElement>("#start-text")!;
    const startPicker =
      document.querySelector<HTMLInputElement>("#start-picker")!;
    const startPickerButton = document.querySelector<HTMLButtonElement>(
      "#start-picker-button",
    )!;
    const startPickerLabel = document.querySelector<HTMLElement>(
      "#start-picker-label",
    )!;
    const startNote = document.querySelector<HTMLElement>("#start-note")!;
    const daysLeft = document.querySelector<HTMLElement>("#days-left")!;

    // 日付の表記はブラウザではなくサービスの言語設定（<html lang>）に合わせる。ja なら yyyy/mm/dd
    const dateFormat = new Intl.DateTimeFormat(document.documentElement.lang, {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      timeZone: "UTC",
    });
    const datePlaceholder = dateFormat
      .formatToParts(new Date(0))
      .map((part) =>
        part.type === "year"
          ? "yyyy"
          : part.type === "month"
            ? "mm"
            : part.type === "day"
              ? "dd"
              : part.value,
      )
      .join("");
    const formatDate = (value: luxon.DateTime) => {
      const utc = new Date(0);
      // Date.UTC は 0〜99 年を 1900 年代にずらすので setUTCFullYear で組み立てる
      utc.setUTCFullYear(value.year, value.month - 1, value.day);
      // 年は 4 桁に揃える（Intl は 50 年を "50" と出すため）
      return dateFormat
        .formatToParts(utc)
        .map((part) =>
          part.type === "year" ? part.value.padStart(4, "0") : part.value,
        )
        .join("");
    };

    // ネイティブの date input とボタンの表示を、テキスト入力の解釈結果に合わせる
    const syncPicker = (
      target: HTMLInputElement,
      label: HTMLElement,
      info: date.DateInfo | null,
    ) => {
      target.value = info?.dateTime.toISODate() ?? "";
      label.textContent = info ? formatDate(info.dateTime) : datePlaceholder;
      label.classList.toggle("picker__label--empty", !info);
    };

    let initialised = false;
    const hint = `日付のみの場合は ${date.TIME_ZONE_LABEL} の 00:00:00 として計算します。`;

    const render = () => {
      const info = date.parseDate(text.value);
      const nextWeekday = info?.weekday ?? "—";
      const nextHoliday = !info
        ? "—"
        : info.holiday === undefined
          ? `不明（${holiday.LAST_YEAR} 年まで対応）`
          : (info.holiday ?? "なし");
      const nextUnixTime = info ? String(info.unixTime) : "—";
      // 結果が変わったときだけ軽く動かす（初期表示では動かさない）
      if (initialised && weekday.textContent !== nextWeekday)
        motion.play(weekday, "pop");
      if (initialised && holidayValue.textContent !== nextHoliday)
        motion.play(holidayValue, "pop");
      if (initialised && unixTime.textContent !== nextUnixTime)
        motion.play(unixTime, "pop");
      weekday.textContent = nextWeekday;
      holidayValue.textContent = nextHoliday;
      holidayValue.classList.toggle("result__holiday--none", !info?.holiday);
      unixTime.textContent = nextUnixTime;
      copyButton.disabled = !info;
      syncPicker(picker, pickerLabel, info);
      note.classList.toggle("note--error", !info && text.value.trim() !== "");
      if (info) {
        note.textContent = `${info.dateTime.toFormat("yyyy-MM-dd HH:mm:ss")}（${date.TIME_ZONE_LABEL}）として計算しています。`;
      } else {
        note.textContent = text.value.trim()
          ? "日付として解釈できません。"
          : hint;
      }

      // 起算日は空欄なら今日として数える
      const startInfo = date.parseDate(startText.value);
      const startValid = !!startInfo || startText.value.trim() === "";
      const start =
        startInfo?.dateTime ?? luxon.DateTime.now().setZone(date.TIME_ZONE);
      const nextDaysLeft =
        info && startValid
          ? date.formatDaysLeft(date.daysUntil(info.dateTime, start))
          : "—";
      if (initialised && daysLeft.textContent !== nextDaysLeft)
        motion.play(daysLeft, "pop");
      daysLeft.textContent = nextDaysLeft;
      syncPicker(startPicker, startPickerLabel, startInfo);
      startNote.classList.toggle("note--error", !startValid);
      startNote.textContent = startValid
        ? `上の日付を期限として、${startInfo ? "" : "今日 "}${formatDate(start)} から数えています。`
        : "起算日を日付として解釈できません。";
    };

    text.addEventListener("input", render);
    // コピー結果はレイアウトを動かさないよう、ボタン上のツールチップで出す
    const createTooltip = (tooltip: HTMLElement) => {
      let timer: ReturnType<typeof setTimeout> | undefined;
      return (message: string) => {
        tooltip.textContent = message;
        tooltip.classList.add("copy__tooltip--visible");
        motion.play(tooltip, "in");
        clearTimeout(timer);
        timer = setTimeout(() => {
          tooltip.classList.remove("copy__tooltip--visible");
        }, 1500);
      };
    };
    const showTooltip = createTooltip(copyTooltip);

    copyButton.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(unixTime.textContent ?? "");
        showTooltip("コピーしました");
      } catch {
        // クリップボードが使えない環境では値を選択状態にして手動コピーに任せる
        getSelection()?.selectAllChildren(unixTime);
        showTooltip("選択しました");
      }
    });

    // カレンダーで選んだ日付をテキスト入力に反映する（日付と起算日で共通）
    const bindPicker = (
      button: HTMLButtonElement,
      target: HTMLInputElement,
      input: HTMLInputElement,
    ) => {
      button.addEventListener("click", () => {
        try {
          target.showPicker();
        } catch {
          // showPicker() に未対応のブラウザではネイティブ input をクリックして開く
          target.click();
        }
      });
      target.addEventListener("input", () => {
        input.value = target.value;
        render();
      });
    };
    bindPicker(pickerButton, picker, text);
    bindPicker(startPickerButton, startPicker, startText);
    startText.addEventListener("input", render);

    // 複数行モード：入力と同じ行に「yyyy年mm月dd日(曜)」で出力する
    const modeButtons = {
      single: document.querySelector<HTMLButtonElement>("#mode-single")!,
      multi: document.querySelector<HTMLButtonElement>("#mode-multi")!,
    };
    const panels = {
      single: document.querySelector<HTMLElement>("#single-panel")!,
      multi: document.querySelector<HTMLElement>("#multi-panel")!,
    };
    const multiInput =
      document.querySelector<HTMLTextAreaElement>("#multi-input")!;
    const multiOutput =
      document.querySelector<HTMLTextAreaElement>("#multi-output")!;
    const multiNote = document.querySelector<HTMLElement>("#multi-note")!;
    const copyMulti = document.querySelector<HTMLButtonElement>("#copy-multi")!;
    const showMultiTooltip = createTooltip(
      document.querySelector<HTMLElement>("#copy-multi-tooltip")!,
    );

    // 選んだモードだけを localStorage に覚えておく（入力した日付は保存しない）
    const modeKey = "toolbox:calendar:mode";
    type Mode = "single" | "multi";
    const readMode = (): Mode => {
      try {
        return localStorage.getItem(modeKey) === "multi" ? "multi" : "single";
      } catch {
        // localStorage が使えない環境では毎回「1件」から始める
        return "single";
      }
    };
    const saveMode = (mode: Mode) => {
      try {
        localStorage.setItem(modeKey, mode);
      } catch {
        // 保存できなくても、そのまま使える
      }
    };
    const setMode = (mode: Mode) => {
      for (const key of ["single", "multi"] as const) {
        modeButtons[key].setAttribute("aria-pressed", String(key === mode));
        panels[key].hidden = key !== mode;
      }
    };
    for (const mode of ["single", "multi"] as const) {
      modeButtons[mode].addEventListener("click", (event) => {
        setMode(mode);
        // チュートリアルが表示のために押した場合（isTrusted が false）は、選択として覚えない
        if (!event.isTrusted) return;
        saveMode(mode);
        if (mode === "multi") multiInput.focus();
      });
    }
    setMode(readMode());

    // 残り日数を付けるかどうかも localStorage に覚えておく
    const multiDays = document.querySelector<HTMLInputElement>("#multi-days")!;
    const multiDaysKey = "toolbox:calendar:multi-days";
    try {
      multiDays.checked = localStorage.getItem(multiDaysKey) === "on";
    } catch {
      // localStorage が使えない環境では毎回オフから始める
    }
    multiDays.addEventListener("change", (event) => {
      renderMulti();
      // チュートリアルなどスクリプトから切り替えた場合は覚えない
      if (!event.isTrusted) return;
      try {
        localStorage.setItem(multiDaysKey, multiDays.checked ? "on" : "off");
      } catch {
        // 保存できなくても、そのまま使える
      }
    });

    const renderMulti = () => {
      const now = luxon.DateTime.now();
      const result = date.formatLines(
        multiInput.value,
        now,
        multiDays.checked ? { daysFrom: now } : {},
      );
      multiOutput.value = result.output;
      copyMulti.disabled = !multiInput.value.trim();
      const passed =
        result.passedLines.length > 0
          ? `${result.passedLines.join("、")} 行目は日付が見つからないので、そのまま出力しています。`
          : "";
      multiNote.classList.toggle(
        "note--error",
        result.parsedCount === 0 && passed !== "",
      );
      if (result.parsedCount > 0) {
        multiNote.textContent = `${result.parsedCount} 件を変換しました。${passed}`;
      } else if (passed) {
        multiNote.textContent = passed;
      } else {
        multiNote.textContent = `1 行に 1 つずつ日付を入力してください。日付のみの入力は ${date.TIME_ZONE_LABEL} として扱います。`;
      }
    };
    multiInput.addEventListener("input", renderMulti);
    copyMulti.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(multiOutput.value);
        showMultiTooltip("コピーしました");
      } catch {
        // クリップボードが使えない環境では出力を選択状態にして手動コピーに任せる
        multiOutput.select();
        showMultiTooltip("選択しました");
      }
    });
    renderMulti();

    const today = luxon.DateTime.now().setZone(date.TIME_ZONE).toISODate();
    if (!text.value) text.value = today ?? "";
    if (!startText.value) startText.value = today ?? "";
    render();
    initialised = true;
  };
  document.addEventListener("astro:page-load", init);
</script>

