---
import * as shared from "#shared";
import Layout from "#ui/Layout.astro";
import ToolIcon from "#ui/ToolIcon.astro";

const tool = shared.tools.find((t) => t.id === "calendar")!;
---

<Layout
  title={tool.name}
  description={tool.description}
  spec={{
    overview:
      "入力された日付の解釈と曜日・祝日・Unix time・起算日からの残り日数の計算、複数行の整形は、すべてブラウザ内で行います（処理は Go で書き、goesm で JavaScript に変換しています）。祝日は外部のデータを使わず「国民の祝日に関する法律」に沿って計算します（振替休日・国民の休日を含む。春分の日・秋分の日は近似式による計算のため、先の年は推計です。2151 年以降は計算できないので「不明」と表示します）。日付のみの入力は JST (UTC+09:00) の 00:00:00 として扱います。",
    network: "なし（入力した日付がサーバーへ送信されることはありません）",
    storage:
      "オフラインでも開けるよう、ページ・スクリプト・フォントをブラウザのキャッシュ（Cache Storage）に保存します。localStorage には、選んだ入力モード（「1件」か「複数行」）と、複数行で残り日数を付けるかどうかだけを保存します。入力した日付と起算日は保存しません。Cookie は使いません。",
    libraries: [
      "goesm（Go で書いた処理を JavaScript に変換）",
      "gosfc（Go の処理をページに読み込む）",
    ],
  }}
  tour={[
    {
      target: "#mode-switch",
      title: "入力モード",
      body: "「1件」は 1 つの日付の曜日と Unix time を、「複数行」は何行もの日付をまとめて整形します。",
    },
    {
      target: "#date-text",
      reveal: "#mode-single",
      title: "日付を入力",
      body: "2026-10-01、2026年10月1日、10/1、20261001 などの形式で入力できます。年や月を省略すると今年・今月として扱います。",
    },
    {
      target: "#date-picker-button",
      reveal: "#mode-single",
      title: "カレンダーから選ぶ",
      body: "カレンダーで日付を選ぶこともできます。テキスト入力と連動します。",
    },
    {
      target: "#start-text",
      reveal: "#mode-single",
      title: "起算日",
      body: "上の日付を期限として、起算日から「あと何日」かを数えます。最初は今日が入っています。明日が期限なら「あと 1 日」、今日なら「本日中」です。",
    },
    {
      target: ".result",
      reveal: "#mode-single",
      title: "結果",
      body: "起算日から期限までの日数、入力した日付の曜日、祝日・休日の名前、Unix time（秒）が表示されます。",
    },
    {
      target: "#multi-input",
      reveal: "#mode-multi",
      title: "複数行で入力",
      body: "1 行に 1 つずつ日付を書きます。形式は行ごとに違っていても構いません。「2027年10月17日(日) 開催」のように文章が続く行や、予定表をそのまま貼り付けても、日付の部分だけを読み取ります。",
    },
    {
      target: "#multi-output",
      reveal: "#mode-multi",
      title: "まとめて出力",
      body: "日付の部分を「2026年10月01日(木)」の形式に整え、それ以外の文字はそのまま、入力と同じ行に出力します。祝日・休日は「(火・祝)」のように表示します。右上のボタンで全部コピーできます。",
    },
    {
      target: "#multi-days",
      reveal: "#mode-multi",
      title: "残り日数",
      body: "オンにすると、出力の日付の後ろに今日から数えた残り日数を「（あと 1 日）」「（本日中）」のように付けます。オン・オフは次に開いたときも覚えています。",
    },
  ]}
>
  <div class="page">
    <div class="tool-header">
      <ToolIcon name={tool.icon} />
      <h1 class="tool-header__name">{tool.name}</h1>
    </div>

    <section class="card calendar">
      <!-- 1 件ずつ調べるモードと、複数行をまとめて整形するモード -->
      <div id="mode-switch" class="mode" role="group" aria-label="入力モード">
        <button
          id="mode-single"
          class="mode__button"
          type="button"
          aria-pressed="true"
        >
          1件
        </button>
        <button
          id="mode-multi"
          class="mode__button"
          type="button"
          aria-pressed="false"
        >
          複数行
        </button>
      </div>

      <div id="single-panel" class="panel">
        <div class="field">
          <label class="field__label" for="date-text">
            日付
          </label>
          <div class="field__inputs">
            <input
              id="date-text"
              class="field__input field__input--text"
              type="text"
              inputmode="text"
              autocomplete="off"
              placeholder="2026-10-01, 10/1, 20261001 など"
              aria-describedby="date-note"
            />
            <!-- ネイティブの date input はブラウザの言語設定で表記が変わる（mm/dd/yyyy など）ため、
                 表示はサービスの言語設定に合わせたボタンにして、カレンダーは showPicker() で開く -->
            <div class="picker">
              <button
                id="date-picker-button"
                class="field__input picker__button"
                type="button"
                aria-label="カレンダーから選択"
              >
                <span id="date-picker-label" class="picker__label">
                  yyyy/mm/dd
                </span>
                <svg
                  class="picker__icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                  <path d="M3 10h18M8 3v4M16 3v4"></path>
                </svg>
              </button>
              <input
                id="date-picker"
                class="picker__native"
                type="date"
                tabindex="-1"
                aria-hidden="true"
              />
            </div>
          </div>
        </div>
        <p id="date-note" class="note" aria-live="polite"></p>

        <!-- 上の日付を期限日として、起算日（デフォルトは今日）から「あと何日」かを数える -->
        <div class="field">
          <label class="field__label" for="start-text">
            起算日
          </label>
          <div class="field__inputs">
            <input
              id="start-text"
              class="field__input field__input--text"
              type="text"
              inputmode="text"
              autocomplete="off"
              placeholder="空欄なら今日"
              aria-describedby="start-note"
            />
            <div class="picker">
              <button
                id="start-picker-button"
                class="field__input picker__button"
                type="button"
                aria-label="起算日をカレンダーから選択"
              >
                <span id="start-picker-label" class="picker__label">
                  yyyy/mm/dd
                </span>
                <svg
                  class="picker__icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                  <path d="M3 10h18M8 3v4M16 3v4"></path>
                </svg>
              </button>
              <input
                id="start-picker"
                class="picker__native"
                type="date"
                tabindex="-1"
                aria-hidden="true"
              />
            </div>
          </div>
        </div>
        <p id="start-note" class="note" aria-live="polite"></p>

        <dl class="result" aria-live="polite">
          <div class="result__row">
            <dt>残り日数</dt>
            <dd id="days-left">—</dd>
          </div>
          <div class="result__row">
            <dt>曜日</dt>
            <dd id="weekday">—</dd>
          </div>
          <div class="result__row">
            <dt>祝日・休日</dt>
            <dd id="holiday">—</dd>
          </div>
          <div class="result__row">
            <dt>Unix time（秒）</dt>
            <dd class="result__value">
              <span id="unix-time" class="result__mono">
                —
              </span>
              <span class="copy">
                <button
                  id="copy-unix-time"
                  class="copy__button"
                  type="button"
                  aria-label="Unix time をコピー"
                  aria-describedby="copy-tooltip"
                  disabled
                >
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="9" y="9" width="12" height="12" rx="2"></rect>
                    <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
                  </svg>
                </button>
                <!-- レイアウトに影響しないよう、コピー結果はボタン上のツールチップで出す -->
                <span
                  id="copy-tooltip"
                  class="copy__tooltip"
                  role="status"
                ></span>
              </span>
            </dd>
          </div>
        </dl>
      </div>

      <div id="multi-panel" class="panel" hidden>
        <div class="field">
          <label class="field__label" for="multi-input">
            日付（1 行ごとに読み取り）
          </label>
          <textarea
            id="multi-input"
            class="field__input multi__textarea"
            rows="6"
            spellcheck="false"
            autocomplete="off"
            placeholder={"2026-10-01\n10/2\n2026年10月3日(土) 締め切り"}
          ></textarea>
        </div>
        <!-- 出力の日付の後ろに、今日から数えた残り日数を付けるかどうか（選択は localStorage に覚える） -->
        <label class="switch">
          <input
            id="multi-days"
            class="switch__input"
            type="checkbox"
            role="switch"
          />
          <span>残り日数を付ける（今日から数えます）</span>
        </label>
        <div class="field">
          <div class="multi__head">
            <label class="field__label" for="multi-output">
              出力（yyyy年mm月dd日(曜)、祝日は(曜・祝)）
            </label>
            <span class="copy">
              <button
                id="copy-multi"
                class="copy__button"
                type="button"
                aria-label="出力をすべてコピー"
                aria-describedby="copy-multi-tooltip"
                disabled
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="9" y="9" width="12" height="12" rx="2"></rect>
                  <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
                </svg>
              </button>
              <span
                id="copy-multi-tooltip"
                class="copy__tooltip"
                role="status"
              ></span>
            </span>
          </div>
          <textarea
            id="multi-output"
            class="field__input multi__textarea"
            rows="6"
            readonly
            spellcheck="false"
          ></textarea>
        </div>
        <p id="multi-note" class="note" aria-live="polite"></p>
      </div>
    </section>
  </div>
</Layout>

<script>
  // ページの動きは Go（../page、日付の処理は ../lib/jpdate）で書き、gosfc が goesm で JavaScript に変換する
  import * as page from "go:toolbox.richinosan.com/apps/calendar/src/page";

  page.Start();
</script>

<style>
  .tool-header {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .tool-header__name {
    font-size: 1.5rem;
    line-height: 1.3;
  }

  /* ヘッダーの下は中央寄せの 1 カラムにする（左だけに寄って右が空かないように） */
  .page {
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
  }

  .mode {
    display: flex;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
    padding: var(--space-1);
    border-radius: 10px;
    background: var(--color-bg);
  }

  .mode__button {
    flex: 1;
    min-height: 2.25rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    cursor: pointer;
  }

  .mode__button[aria-pressed="true"] {
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 700;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }

  .panel {
    display: grid;
    gap: var(--space-3);
  }

  .panel[hidden] {
    display: none;
  }

  .switch {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.25rem;
    cursor: pointer;
  }

  .switch__input {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 1.25rem;
    margin: 0;
    border-radius: 999px;
    background: var(--color-border);
    appearance: none;
    cursor: pointer;
    transition: background-color 0.15s ease-out;
  }

  .switch__input::before {
    position: absolute;
    top: 2px;
    left: 2px;
    width: calc(1.25rem - 4px);
    height: calc(1.25rem - 4px);
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.2);
    content: "";
    transition: translate 0.15s ease-out;
  }

  .switch__input:checked {
    background: var(--color-accent);
  }

  .switch__input:checked::before {
    translate: 1rem 0;
  }

  .switch__input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .multi__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  /* 右端のボタンのツールチップは、狭い画面で画面外に出ないよう右揃えにする */
  .multi__head .copy__tooltip {
    right: 0;
    left: auto;
    transform: translate(0, 4px);
  }

  .multi__head .copy__tooltip--visible {
    transform: translate(0, 0);
  }

  .multi__textarea {
    min-height: 9rem;
    resize: vertical;
    font-variant-numeric: tabular-nums;
    line-height: 1.6;
  }

  .field {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
  }

  .field__label {
    font-weight: 700;
  }

  .field__inputs {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .field__input {
    width: 100%;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    color: inherit;
    font: inherit;
  }

  .field__input--text {
    flex: 1 1 12rem;
    width: auto;
    min-width: 0;
  }

  .picker {
    position: relative;
    flex: 0 1 11rem;
    min-width: 0;
  }

  .picker__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }

  .picker__label--empty {
    color: var(--color-text-muted);
  }

  .picker__icon {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-text-muted);
  }

  /* showPicker() の位置合わせ用に残し、見た目と操作はボタンに任せる */
  .picker__native {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
  }

  .note {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .note--error {
    color: light-dark(#c5221f, #f28b82);
  }

  .result {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .result__row dt {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .result__row dd {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .result__value {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .result__mono {
    min-width: 0;
    font-variant-numeric: tabular-nums;
  }

  .copy {
    position: relative;
    flex: none;
  }

  .copy__button {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .copy__button:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .copy__button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .copy__button svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .copy__tooltip {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    padding: var(--space-1) var(--space-2);
    border-radius: 6px;
    background: var(--color-text);
    color: var(--color-surface);
    font-size: 0.75rem;
    font-weight: 400;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 4px);
    transition:
      opacity 0.15s,
      transform 0.15s;
  }

  /* 結果が変わったときに軽く動かすので、インラインブロックにする */
  #days-left,
  #weekday,
  #holiday,
  #unix-time {
    display: inline-block;
  }

  /* 祝日でない日は「なし」を控えめに出す */
  .result__row dd.result__holiday--none {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .copy__tooltip--visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .copy__tooltip,
    .switch__input,
    .switch__input::before {
      transition: none;
    }
  }
</style>
