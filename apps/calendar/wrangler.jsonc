{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toolbox-calendar",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
  },
  "routes": [
    {
      "pattern": "toolbox.richinosan.com/calendar",
      "zone_name": "richinosan.com",
    },
    {
      "pattern": "toolbox.richinosan.com/calendar/*",
      "zone_name": "richinosan.com",
    },
  ],
}
