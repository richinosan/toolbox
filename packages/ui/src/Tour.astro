---
import type * as specTypes from "./spec";

interface Props {
  steps: readonly specTypes.TourStep[];
}

const { steps } = Astro.props;
---

<div id="tour" class="tour" popover="manual" data-steps={JSON.stringify(steps)}>
  <div class="tour__spotlight"></div>
  <div
    class="tour__bubble"
    role="dialog"
    aria-modal="true"
    aria-labelledby="tour-title"
    aria-describedby="tour-body"
  >
    <p class="tour__progress"></p>
    <h2 id="tour-title" class="tour__title"></h2>
    <p id="tour-body" class="tour__body"></p>
    <div class="tour__actions">
      <button
        class="tour__button tour__button--skip"
        type="button"
        data-tour="close"
      >
        終了
      </button>
      <button class="tour__button" type="button" data-tour="prev">
        戻る
      </button>
      <button
        class="tour__button tour__button--primary"
        type="button"
        data-tour="next"
      >
        次へ
      </button>
    </div>
  </div>
</div>

<script>
  import * as motion from "./motion";
  import * as singleton from "./singleton";

  type Step = {
    target: string;
    title: string;
    body: string;
    reveal?: string;
  };

  const margin = 8;
  const gap = 12;

  let tour: HTMLElement | null = null;
  let steps: { step: Step; element: HTMLElement }[] = [];
  let index = 0;

  const part = <T extends HTMLElement>(selector: string) =>
    tour!.querySelector<T>(selector)!;

  const place = () => {
    const current = steps[index];
    if (!tour?.matches(":popover-open") || !current) return;
    const spotlight = part(".tour__spotlight");
    const bubble = part(".tour__bubble");
    const rect = current.element.getBoundingClientRect();
    // 画面端の要素でも枠が切れないように画面内に収める
    const edge = 2;
    const spotTop = Math.max(edge, rect.top - margin);
    const spotLeft = Math.max(edge, rect.left - margin);
    const spotRight = Math.min(window.innerWidth - edge, rect.right + margin);
    const spotBottom = Math.min(
      window.innerHeight - edge,
      rect.bottom + margin,
    );
    spotlight.style.top = `${spotTop}px`;
    spotlight.style.left = `${spotLeft}px`;
    spotlight.style.width = `${spotRight - spotLeft}px`;
    spotlight.style.height = `${spotBottom - spotTop}px`;

    // 下に入らなければ上に出す。左右は画面内に収める
    const bubbleRect = bubble.getBoundingClientRect();
    const below = spotBottom + gap;
    const fitsBelow = below + bubbleRect.height <= window.innerHeight;
    const top = fitsBelow
      ? below
      : Math.max(gap, spotTop - gap - bubbleRect.height);
    const targetCenter = rect.left + rect.width / 2;
    const left = Math.min(
      Math.max(gap, targetCenter - bubbleRect.width / 2),
      window.innerWidth - bubbleRect.width - gap,
    );
    bubble.style.top = `${top}px`;
    bubble.style.left = `${left}px`;
    // 吹き出しのしっぽを対象の中央に向ける（角丸にかからない範囲に収める）
    const tail = Math.min(
      Math.max(20, targetCenter - left),
      bubbleRect.width - 20,
    );
    bubble.style.setProperty("--tail-x", `${tail}px`);
    bubble.dataset["side"] = fitsBelow ? "below" : "above";
  };

  const show = (nextIndex: number) => {
    const current = steps[nextIndex];
    if (!current) return;
    index = nextIndex;
    part(".tour__progress").textContent = `${index + 1} / ${steps.length}`;
    part(".tour__title").textContent = current.step.title;
    part(".tour__body").textContent = current.step.body;
    part<HTMLButtonElement>("[data-tour=prev]").hidden = index === 0;
    const next = part<HTMLButtonElement>("[data-tour=next]");
    next.textContent = index === steps.length - 1 ? "完了" : "次へ";
    // モードやタブの切り替えで隠れている対象は、切り替えボタンを押して表示する
    if (current.element.getClientRects().length === 0 && current.step.reveal)
      document.querySelector<HTMLElement>(current.step.reveal)?.click();
    current.element.scrollIntoView({ block: "center", behavior: "instant" });
    place();
    // ステップが変わるたびに吹き出しを跳ねさせる
    motion.bounce(part(".tour__bubble"), "in");
    next.focus();
  };

  const start = () => {
    if (!tour) return;
    const allSteps: Step[] = JSON.parse(tour.dataset["steps"] ?? "[]");
    steps = allSteps.flatMap((step) => {
      const element = document.querySelector<HTMLElement>(step.target);
      // 隠れていても reveal で表示できるステップは残す
      return element && (element.getClientRects().length > 0 || step.reveal)
        ? [{ step, element }]
        : [];
    });
    if (steps.length === 0) return;
    document
      .querySelectorAll<HTMLElement>("[popover]:popover-open")
      .forEach((popover) => popover.hidePopover());
    tour.showPopover();
    show(0);
  };

  const end = () => tour?.hidePopover();

  // ClientRouter でページが入れ替わるたびに、そのページのチュートリアル要素に付け直す
  const init = () => {
    tour = document.querySelector<HTMLElement>("#tour");
    if (!tour) return;
    part("[data-tour=prev]").addEventListener("click", () => show(index - 1));
    part("[data-tour=next]").addEventListener("click", () =>
      index === steps.length - 1 ? end() : show(index + 1),
    );
    part("[data-tour=close]").addEventListener("click", end);
    tour.addEventListener("keydown", (event) => {
      if (event.key === "Escape") end();
      if (event.key === "ArrowRight" && index < steps.length - 1)
        show(index + 1);
      if (event.key === "ArrowLeft" && index > 0) show(index - 1);
    });
    document
      .querySelectorAll("[data-tour-start]")
      .forEach((button) => button.addEventListener("click", start));
  };

  // 先に読み込まれたコピーが、以降のページ（別アプリ含む）のチュートリアルもまとめて扱う
  singleton.once("tour", () => {
    window.addEventListener("resize", place);
    window.addEventListener("scroll", place, { passive: true });
    document.addEventListener("astro:page-load", init);
  });
</script>

<style>
  .tour {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    overflow: hidden;
  }

  .tour__spotlight {
    position: fixed;
    border-radius: 10px;
    box-shadow: 0 0 0 100vmax rgb(0 0 0 / 0.55);
    outline: 2px solid var(--color-accent);
    transition:
      top 0.2s,
      left 0.2s,
      width 0.2s,
      height 0.2s;
    pointer-events: none;
  }

  .tour__bubble {
    position: fixed;
    width: min(20rem, calc(100vw - var(--gutter) * 2));
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 8px 32px rgb(0 0 0 / 0.24);
    transition:
      top 0.2s,
      left 0.2s;
  }

  /* 吹き出しのしっぽ。対象の下に出すときは上向き、上に出すときは下向き */
  .tour__bubble::before {
    position: absolute;
    left: var(--tail-x, 50%);
    width: 14px;
    height: 14px;
    background: inherit;
    content: "";
    transform: translateX(-50%) rotate(45deg);
  }

  .tour__bubble[data-side="below"]::before {
    top: -7px;
  }

  .tour__bubble[data-side="above"]::before {
    bottom: -7px;
  }

  .tour__progress {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .tour__title {
    margin-top: var(--space-1);
    font-size: 1rem;
  }

  .tour__body {
    margin-top: var(--space-1);
    font-size: 0.875rem;
  }

  .tour__actions {
    display: flex;
    gap: var(--space-2);
    justify-content: flex-end;
    margin-top: var(--space-4);
  }

  .tour__button {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .tour__button[hidden] {
    display: none;
  }

  .tour__button--skip {
    margin-right: auto;
    border-color: transparent;
    color: var(--color-text-muted);
  }

  .tour__button--primary {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: #fff;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .tour__spotlight,
    .tour__bubble {
      transition: none;
    }
  }
</style>
