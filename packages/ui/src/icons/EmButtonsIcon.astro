---
// Office（Fluent）風のボタンアイコン。丸いボタンの上にポインターが重なる。
// 同じページに複数回描画される（ヘッダーのツール一覧など）ため、グラデーション等の id を描画ごとに変える。
const globalCounter = globalThis as typeof globalThis & {
  toolboxIconRenderCount?: number;
};
const instance = (globalCounter.toolboxIconRenderCount =
  (globalCounter.toolboxIconRenderCount ?? 0) + 1);
const id = (name: string) => `tb-em-buttons-${name}-${instance}`;
---

<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id={id("button")} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#4be08a" />
      <stop offset="1" stop-color="#05a648" />
    </linearGradient>
    <linearGradient id={id("pointer")} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#d7e6f5" />
    </linearGradient>
    <filter id={id("shadow")} x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow
        dx="0"
        dy="1"
        stdDeviation="1"
        flood-color="#05381c"
        flood-opacity="0.3"
      />
    </filter>
  </defs>

  <g filter={`url(#${id("shadow")})`}>
    <rect
      x="3"
      y="8"
      width="42"
      height="22"
      rx="11"
      fill={`url(#${id("button")})`}
    />
  </g>
  <rect
    x="9"
    y="12"
    width="30"
    height="3"
    rx="1.5"
    fill="#ffffff"
    opacity="0.35"
  ></rect>
  <g fill="#ffffff">
    <rect x="12" y="17" width="14" height="4" rx="2"></rect>
  </g>

  <g filter={`url(#${id("shadow")})`}>
    <path
      d="M24 22.5 40.2 30.1l-6.8 2.3 4.1 7.2-3.6 2-4.1-7.1-4.6 4.9z"
      fill={`url(#${id("pointer")})`}
      stroke="#1b3a5c"
      stroke-width="1.6"
      stroke-linejoin="round"
    ></path>
  </g>
</svg>
