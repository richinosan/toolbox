---
// Office（Fluent）風のカレンダーアイコン。グラデーションと重なりで立体感を出す。
// 同じページに複数回描画される（ヘッダーのツール一覧など）ため、グラデーション等の id を描画ごとに変える。
// 非表示の要素内の定義を参照すると描画されないので、id の共有は不可。
const globalCounter = globalThis as typeof globalThis & { __tbIconId?: number };
const instance = (globalCounter.__tbIconId =
  (globalCounter.__tbIconId ?? 0) + 1);
const id = (name: string) => `tb-calendar-${name}-${instance}`;
---

<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id={id("body")} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#e3eefb" />
    </linearGradient>
    <linearGradient id={id("header")} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#3ccbf4" />
      <stop offset="1" stop-color="#0f6cbd" />
    </linearGradient>
    <linearGradient id={id("plate")} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1a86d9" />
      <stop offset="1" stop-color="#0b4f9c" />
    </linearGradient>
    <filter id={id("shadow")} x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow
        dx="0"
        dy="1"
        stdDeviation="1"
        flood-color="#0b3a6e"
        flood-opacity="0.25"
      />
    </filter>
  </defs>

  <g filter={`url(#${id("shadow")})`}>
    <rect
      x="8"
      y="7"
      width="36"
      height="35"
      rx="6"
      fill={`url(#${id("body")})`}
    />
    <path
      d="M8 13a6 6 0 0 1 6-6h24a6 6 0 0 1 6 6v5H8z"
      fill={`url(#${id("header")})`}
    />
  </g>
  <rect x="16" y="3" width="4" height="9" rx="2" fill="#0b4f9c" />
  <rect x="32" y="3" width="4" height="9" rx="2" fill="#0b4f9c" />

  <g fill="#a9d1f5">
    <rect x="27" y="23" width="5" height="5" rx="1.25" />
    <rect x="35" y="23" width="5" height="5" rx="1.25" />
    <rect x="35" y="31" width="5" height="5" rx="1.25" />
  </g>
  <rect x="27" y="31" width="5" height="5" rx="1.25" fill="#0f6cbd" />

  <g filter={`url(#${id("shadow")})`}>
    <rect
      x="3"
      y="21"
      width="20"
      height="20"
      rx="3.5"
      fill={`url(#${id("plate")})`}
    />
  </g>
  <text
    x="13"
    y="35.5"
    fill="#ffffff"
    font-family="'LINE Seed JP', system-ui, sans-serif"
    font-size="12"
    font-weight="700"
    text-anchor="middle"
  >
    31
  </text>
</svg>
