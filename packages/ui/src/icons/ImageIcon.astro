---
// Office（Fluent）風の画像アイコン。写真（空・山・太陽）の上に文字入れの「T」が重なる。
// 同じページに複数回描画される（ヘッダーのツール一覧など）ため、グラデーション等の id を描画ごとに変える。
const globalCounter = globalThis as typeof globalThis & {
  toolboxIconRenderCount?: number;
};
const instance = (globalCounter.toolboxIconRenderCount =
  (globalCounter.toolboxIconRenderCount ?? 0) + 1);
const id = (name: string) => `tb-image-${name}-${instance}`;
---

<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id={id("sky")} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8fd8ff" />
      <stop offset="1" stop-color="#2f8de4" />
    </linearGradient>
    <linearGradient id={id("hill")} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5fd38d" />
      <stop offset="1" stop-color="#14874a" />
    </linearGradient>
    <linearGradient id={id("badge")} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#a68bff" />
      <stop offset="1" stop-color="#5b3fd6" />
    </linearGradient>
    <clipPath id={id("photo")}>
      <rect x="3" y="7" width="36" height="30" rx="5"></rect>
    </clipPath>
    <filter id={id("shadow")} x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow
        dx="0"
        dy="1"
        stdDeviation="1"
        flood-color="#0b2f5c"
        flood-opacity="0.3"
      />
    </filter>
  </defs>

  <g filter={`url(#${id("shadow")})`}>
    <rect
      x="3"
      y="7"
      width="36"
      height="30"
      rx="5"
      fill={`url(#${id("sky")})`}
    ></rect>
  </g>
  <g clip-path={`url(#${id("photo")})`}>
    <circle cx="29" cy="15" r="4" fill="#ffd54a"></circle>
    <path d="M1 37 15 20l9 10 5-5 12 12z" fill={`url(#${id("hill")})`}></path>
  </g>

  <g filter={`url(#${id("shadow")})`}>
    <rect
      x="25"
      y="24"
      width="20"
      height="20"
      rx="5"
      fill={`url(#${id("badge")})`}
    ></rect>
  </g>
  <path d="M30 29h10v3h-3.5v8h-3v-8H30z" fill="#ffffff"></path>
</svg>
