---
import * as assets from "astro:assets";
import * as transitions from "astro:transitions";
import * as shared from "#shared";
import GitHubIcon from "./icons/GitHubIcon.astro";
import GridIcon from "./icons/GridIcon.astro";
import HelpIcon from "./icons/HelpIcon.astro";
import type * as specTypes from "./spec";
import ToolTile from "./ToolTile.astro";
import Tour from "./Tour.astro";
import "./styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** ？ボタンで表示する技術仕様（全ページ必須） */
  spec: specTypes.TechSpec;
  /** チュートリアルでヘッダーより前に案内するページ固有のステップ */
  tour?: readonly specTypes.TourStep[];
}

const { title, description, spec, tour = [] } = Astro.props;
const tourSteps: specTypes.TourStep[] = [
  ...tour,
  {
    target: "#tools-button",
    title: "ツール一覧",
    body: "ここから他のツールに移動できます。",
  },
  {
    target: "#spec-button",
    title: "技術仕様",
    body: "通信や保存される情報など、このページの技術仕様を確認できます。チュートリアルもここから始められます。",
  },
  {
    target: "#github-link",
    title: "ソースコード",
    body: "GitHub のリポジトリを開きます。",
  },
];
const repositoryUrl = "https://github.com/richinosan/toolbox";
const siteName = "Toolbox";
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
// favicon はツールごと。ツール（base 付きの app）は自分の public/icon.svg（例: /calendar/icon.svg）、
// ダッシュボードはサイト共通の /icons/icon.svg を使う。
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const faviconHref = base ? `${base}/icon.svg` : "/icons/icon.svg";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <assets.Font cssVariable="--font-line-seed-jp" />
    {description && <meta name="description" content={description} />}
    <!-- PWA: manifest / ホーム画面アイコン / Service Worker はサイトのルート（dashboard の Worker）が配信する -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1a1e24"
      media="(prefers-color-scheme: dark)"
    />
    <transitions.ClientRouter />
  </head>
  <body>
    <!-- ヘッダーとフッターは ClientRouter のページ遷移でも入れ替えずに残す -->
    <header class="site-header" transition:persist="site-header">
      <div class="container site-header__inner">
        <button
          id="tools-button"
          class="icon-button"
          type="button"
          popovertarget="tools-popover"
          aria-label="ツール一覧"
          title="ツール一覧"
        >
          <GridIcon />
        </button>
        <a class="site-header__brand" href="/">
          {siteName}
        </a>
        <div class="site-header__actions">
          <button
            id="spec-button"
            class="icon-button"
            type="button"
            popovertarget="spec-popover"
            aria-label="技術仕様"
            title="技術仕様"
          >
            <HelpIcon />
          </button>
          <a
            id="github-link"
            class="icon-button"
            href={repositoryUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub リポジトリ"
            title="GitHub リポジトリ"
          >
            <GitHubIcon />
          </a>
        </div>
      </div>
    </header>

    <div
      id="tools-popover"
      class="popover popover--tools"
      popover
      aria-labelledby="tools-title"
    >
      <div class="popover__header">
        <h2 id="tools-title" class="popover__title">
          ツール一覧
        </h2>
        <button
          class="icon-button"
          type="button"
          popovertarget="tools-popover"
          popovertargetaction="hide"
          aria-label="閉じる"
        >
          ×
        </button>
      </div>
      <ul class="tools-menu">
        {shared.tools.map((tool) => (
          <li>
            <ToolTile tool={tool} />
          </li>
        ))}
      </ul>
      <a class="tools-menu__all" href="/">
        すべてのツールを見る
      </a>
    </div>

    <div id="spec-popover" class="popover" popover aria-labelledby="spec-title">
      <div class="popover__header">
        <h2 id="spec-title" class="popover__title">
          技術仕様
        </h2>
        <button
          class="icon-button"
          type="button"
          popovertarget="spec-popover"
          popovertargetaction="hide"
          aria-label="閉じる"
        >
          ×
        </button>
      </div>
      <button class="tour-start" type="button" data-tour-start>
        チュートリアルを開始
      </button>
      <dl class="spec">
        <dt>動作</dt>
        <dd>{spec.overview}</dd>
        <dt>ネットワーク通信</dt>
        <dd>{spec.network}</dd>
        <dt>保存される情報</dt>
        <dd>{spec.storage}</dd>
        <dt>使用ライブラリ</dt>
        <dd>
          {spec.libraries.length > 0 ? spec.libraries.join("、") : "なし"}
        </dd>
        <dt>ソースコード</dt>
        <dd>
          <a href={repositoryUrl}>{repositoryUrl.replace("https://", "")}</a>
        </dd>
      </dl>
    </div>
    <Tour steps={tourSteps} />
    <main class="container site-main">
      <slot />
    </main>
    <footer class="site-footer" transition:persist="site-footer">
      <div class="container site-footer__inner">
        <a href="/">{siteName}</a>
      </div>
    </footer>
  </body>
</html>

<script>
  import * as motion from "./motion";
  import * as singleton from "./singleton";

  // ボタンやタイルは押したときにわずかに縮む。document に付けるので ClientRouter の遷移後もそのまま効く
  singleton.once("press-feedback", () => {
    document.addEventListener("click", (event) => {
      const target =
        event.target instanceof Element
          ? event.target.closest(
              "button:not(:disabled), .tool-tile, .icon-button",
            )
          : null;
      if (target) motion.play(target, "press");
    });
  });

  // オフラインでも開けるように Service Worker を登録する（本番ビルドのみ）
  if (import.meta.env.PROD && "serviceWorker" in navigator) {
    navigator.serviceWorker.register("/sw.js").catch(() => {
      // 登録できなくてもページはそのまま使える
    });
  }
</script>

<style>
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
  }

  .site-header__actions {
    display: flex;
    gap: var(--space-1);
    margin-left: auto;
  }

  .site-header__brand {
    margin-left: var(--space-2);
    font-weight: 700;
    font-size: 1.125rem;
    text-decoration: none;
  }

  .site-main {
    flex: 1;
    width: 100%;
    padding-block: var(--space-8);
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .site-footer__inner {
    display: flex;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .icon-button {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .icon-button:hover {
    background: var(--color-bg);
    color: var(--color-text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .icon-button :global(svg) {
      transition: translate 0.15s ease-out;
    }

    .icon-button:hover :global(svg) {
      translate: 0 -1px;
    }

    /* ポップアップは開くたびにさっとフェードインする */
    .popover:popover-open {
      animation: fade-in 0.18s cubic-bezier(0.2, 0, 0, 1);
    }

    .popover--tools:popover-open {
      transform-origin: top left;
    }

    .popover:not(.popover--tools):popover-open {
      transform-origin: top center;
    }
  }

  .icon-button :global(svg) {
    width: 1.375rem;
    height: 1.375rem;
  }

  .popover {
    width: min(32rem, calc(100vw - var(--gutter) * 2));
    max-height: calc(100dvh - var(--space-8) * 2);
    overflow: auto;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 8px 32px rgb(0 0 0 / 0.16);
    overflow-wrap: anywhere;
  }

  .popover::backdrop {
    background: rgb(0 0 0 / 0.3);
  }

  /* ツールが多くてスクロールしても見出しと閉じるボタンは残す */
  .popover__header {
    position: sticky;
    /* sticky の基準は padding の内側なので、padding 分だけ上に貼り付ける */
    top: calc(var(--space-6) * -1);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: calc(var(--space-6) * -1);
    padding-block: var(--space-6) var(--space-4);
    background: var(--color-surface);
  }

  .popover__title {
    font-size: 1.125rem;
  }

  /* ツール一覧はグリッドボタンの近く（左上）に出す */
  .popover--tools {
    inset: 3.5rem auto auto
      max(var(--gutter), calc((100vw - var(--page-width)) / 2));
    margin: 0;
    width: min(32rem, calc(100vw - var(--gutter) * 2));
  }

  .popover--tools::backdrop {
    background: transparent;
  }

  .tools-menu {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 104px), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tools-menu__all {
    display: block;
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .spec {
    display: grid;
    gap: var(--space-1);
    margin: 0;
  }

  .spec dt {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .spec dt:first-child {
    margin-top: 0;
  }

  .spec dd {
    margin: 0;
  }

  .tour-start {
    width: 100%;
    margin-bottom: var(--space-6);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-accent);
    border-radius: 8px;
    background: var(--color-accent-soft);
    color: var(--color-text);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
</style>
