---
import { CalendarDays } from "@lucide/astro";
import type { ToolIconName } from "@toolbox/shared";

interface Props {
  name: ToolIconName;
}

const icons = {
  calendar: CalendarDays,
} satisfies Record<ToolIconName, unknown>;

const { name } = Astro.props;
const Icon = icons[name];
---

<span class="tool-icon" aria-hidden="true">
  <Icon />
</span>

<style>
  /* 大きさは利用側で --tool-icon-size を指定して変える */
  .tool-icon {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: var(--tool-icon-size, 2.75rem);
    height: var(--tool-icon-size, 2.75rem);
    border-radius: 22%;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .tool-icon :global(svg) {
    width: 60%;
    height: 60%;
  }
</style>
