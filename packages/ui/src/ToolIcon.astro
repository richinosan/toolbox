---
import type * as shared from "#shared";
import CalendarIcon from "./icons/CalendarIcon.astro";
import EmButtonsIcon from "./icons/EmButtonsIcon.astro";
import ImageIcon from "./icons/ImageIcon.astro";

interface Props {
  name: shared.ToolIconName;
}

const icons = {
  calendar: CalendarIcon,
  "em-buttons": EmButtonsIcon,
  image: ImageIcon,
} satisfies Record<shared.ToolIconName, unknown>;

const { name } = Astro.props;
const Icon = icons[name];
---

<span class="tool-icon" aria-hidden="true">
  <Icon />
</span>

<!-- /menu の HTML 断片（別ビルドの要素）にも効くよう、スコープを付けない -->
<style is:global>
  /* 大きさは利用側で --tool-icon-size を指定して変える */
  .tool-icon {
    display: inline-block;
    flex: none;
    width: var(--tool-icon-size, 2.75rem);
    height: var(--tool-icon-size, 2.75rem);
  }

  .tool-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
